# ------------------------------------------------------------------
# VetPepePepito - variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores locales.
# ------------------------------------------------------------------

# Clave de sesión de Flask (cámbiala en cualquier despliegue real)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# SQL Server
DB_SERVER=MSI\SQLEXPRESS
DB_NAME=VetPepePepito
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticación Windows: deja DB_USER vacío y DB_TRUSTED=yes
# Autenticación SQL: llena DB_USER / DB_PASSWORD y DB_TRUSTED=no
DB_USER=
DB_PASSWORD=
DB_TRUSTED=yes

# Datos visibles de la clínica
CLINIC_PHONE=8888-8888
CLINIC_ADDRESS=Managua, Nicaragua
CURRENCY=C$
